linters: linters_with_tags(tags = c("best_practices", "common_mistakes", "readability", "correctness", "robustness"), object_length_linter = NULL, line_length_linter = NULL, indentation_linter = NULL, cyclocomp_linter = NULL, implicit_integer_linter = NULL, redundant_equals_linter = NULL, fixed_regex_linter = NULL, paste_linter = NULL, object_overwrite_linter = lintr::object_overwrite_linter(), nonportable_path_linter = lintr::nonportable_path_linter(lax = FALSE), undesirable_function_linter = lintr::undesirable_function_linter(fun = lintr::default_undesirable_functions), T_and_F_symbol_linter = lintr::T_and_F_symbol_linter(), class_equals_linter = lintr::class_equals_linter(), package_hooks_linter = lintr::package_hooks_linter(), unreachable_code_linter = lintr::unreachable_code_linter(), duplicate_argument_linter = lintr::duplicate_argument_linter(), commas_linter = lintr::commas_linter(), assignment_linter = lintr::assignment_linter(), infix_spaces_linter = lintr::infix_spaces_linter(), semicolon_linter = lintr::semicolon_linter(), trailing_blank_lines_linter = lintr::trailing_blank_lines_linter(), trailing_whitespace_linter = lintr::trailing_whitespace_linter(), quotes_linter = lintr::quotes_linter(), absolute_path_linter = lintr::absolute_path_linter(lax = FALSE), nested_ifelse_linter = lintr::nested_ifelse_linter(), any_duplicated_linter = lintr::any_duplicated_linter(), outer_negation_linter = lintr::outer_negation_linter())
exclusions: list("tests/testthat.R", "renv/", "renv.lock", "analysis-report.Rmd", "inst/", "data-raw/")
